---
import type { GetStaticPaths } from 'astro';

import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import Thumb from '../../../../components/Thumb.astro';
import Pagination from '../../../../components/Pagination.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { displayDate } from '../../../../lib/content/build-context.js';
import { loadSite, seriesPosts } from '../../../../lib/content/collections.js';
import {
  pageNumbers,
  pageSlice,
  paginate,
  seriesIndexUrl,
  seriesPageUrl,
  tagUrl,
} from '../../../../lib/routing/urls.js';
import { buildMetadata } from '../../../../lib/seo/metadata.js';
import { PAGE_SIZE } from '../../../../lib/site.js';

/**
 * A single series, pages two and beyond.
 *
 * Paths are generated only for series that are public and only for page
 * numbers with articles behind them, so an unknown series or an over-run page
 * number resolves to the host's real 404 rather than an empty list.
 */

export const getStaticPaths: GetStaticPaths = async () => {
  const site = await loadSite();

  return site.series.flatMap((series) => {
    const total = seriesPosts(site, series.id).length;
    return pageNumbers(total, PAGE_SIZE)
      .filter((page) => page > 1)
      .map((page) => ({ params: { series: series.id, page: String(page) } }));
  });
};

const site = await loadSite();
const seriesId = Astro.params['series'] ?? '';
const page = Number(Astro.params['page']);
const series = site.series.find((entry) => entry.id === seriesId);

if (series === undefined) {
  return Astro.rewrite('/404');
}

const posts = seriesPosts(site, series.id);
const pagePosts = pageSlice(posts, page);

if (pagePosts.length === 0) {
  return Astro.rewrite('/404');
}

const pagination = paginate(posts.length, page, (target) => seriesPageUrl(series.id, target));

const meta = buildMetadata({
  title: `系列：${series.title} · 第 ${page} 页`,
  description: `${series.title} 系列的公开文章，共 ${posts.length} 篇（第 ${page} 页）。`,
  pathname: seriesPageUrl(series.id, page),
});
---

<BaseLayout meta={meta}>
  <div class="wrap">
    <Breadcrumbs
      items={[
        { label: '系列', href: seriesIndexUrl() },
        { label: series.title, href: seriesPageUrl(series.id, 1) },
        { label: `第 ${page} 页` },
      ]}
    />

    <div class="page-head">
      <h1>{series.title} · 第 {page} 页</h1>
      <p class="page-head__description">
        共 {posts.length} 篇公开文章，按系列顺序排列。
      </p>
    </div>

    {
      posts.length === 0 ? (
        <EmptyState message="此系列尚无公开文章。" />
      ) : (
        <>
          <ol class="index-list">
            {pagePosts.map((post) => (
              <li class="index-row">
                <span class="index-row__date">#{post.data.series?.order ?? 0}</span>

                <h2 class="index-row__title">
                  <a href={post.url}>{post.data.title}</a>
                </h2>

                <div class="index-row__meta">
                  <time datetime={post.data.publishedAt}>
                    {displayDate(post.data.publishedAt)}
                  </time>
                  {post.data.tags.map((tag) => (
                    <a class="tag-chip" href={tagUrl(tag.id)}>{tag.label}</a>
                  ))}
                </div>

                <div class="index-row__thumb">
                  <Thumb
                    src={post.data.cover.src}
                    alt={post.data.cover.alt}
                    fallbackText={[...post.data.title][0] ?? '·'}
                  />
                </div>
              </li>
            ))}
          </ol>

          <Pagination pagination={pagination} label={`${series.title} 系列分页`} />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .index-row__date {
    font-weight: 600;
    color: var(--color-text);
  }
</style>
