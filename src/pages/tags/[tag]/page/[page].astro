---
import type { GetStaticPaths } from 'astro';

import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import IndexList from '../../../../components/IndexList.astro';
import Pagination from '../../../../components/Pagination.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { loadSite, postsWithTag } from '../../../../lib/content/collections.js';
import {
  pageNumbers,
  pageSlice,
  paginate,
  tagPageUrl,
  tagsIndexUrl,
} from '../../../../lib/routing/urls.js';
import { buildMetadata } from '../../../../lib/seo/metadata.js';
import { PAGE_SIZE } from '../../../../lib/site.js';

/**
 * A single tag, pages two and beyond.
 *
 * Paths exist only for tags that are public and only for page numbers that
 * have articles behind them, so neither a missing tag nor an over-run page
 * number can produce a file. A request for either reaches the host's real 404.
 */

export const getStaticPaths: GetStaticPaths = async () => {
  const site = await loadSite();

  return site.tags.flatMap((tag) => {
    const total = postsWithTag(site, tag.id).length;
    return pageNumbers(total, PAGE_SIZE)
      .filter((page) => page > 1)
      .map((page) => ({ params: { tag: tag.id, page: String(page) } }));
  });
};

const site = await loadSite();
const tagId = Astro.params['tag'] ?? '';
const page = Number(Astro.params['page']);
const tag = site.tags.find((entry) => entry.id === tagId);

if (tag === undefined) {
  return Astro.rewrite('/404');
}

const posts = postsWithTag(site, tag.id);
const pagePosts = pageSlice(posts, page);

if (pagePosts.length === 0) {
  return Astro.rewrite('/404');
}

const pagination = paginate(posts.length, page, (target) => tagPageUrl(tag.id, target));

const meta = buildMetadata({
  title: `标签：${tag.label} · 第 ${page} 页`,
  description: `${tag.label} 标签下的公开文章，共 ${posts.length} 篇（第 ${page} 页）。`,
  pathname: tagPageUrl(tag.id, page),
});
---

<BaseLayout meta={meta}>
  <div class="wrap">
    <Breadcrumbs
      items={[{ label: '标签', href: tagsIndexUrl() }, { label: tag.label, href: tagPageUrl(tag.id, 1) }, { label: `第 ${page} 页` }]}
    />

    <div class="page-head">
      <h1>{tag.label} · 第 {page} 页</h1>
      <p class="page-head__description">
        标签 id <span class="tag-id">{tag.id}</span>，共 {posts.length} 篇公开文章。
      </p>
    </div>

    {
      posts.length === 0 ? (
        <EmptyState message="此标签下尚无公开文章。" />
      ) : (
        <>
          <IndexList posts={pagePosts} />
          <Pagination pagination={pagination} label={`${tag.label} 标签分页`} />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .tag-id {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta-lg);
  }
</style>
