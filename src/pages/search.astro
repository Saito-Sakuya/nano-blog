---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSite } from '../lib/content/collections.js';
import { buildMetadata } from '../lib/seo/metadata.js';
import { archivePageUrl, postsIndexUrl } from '../lib/routing/urls.js';

/**
 * The one search interface.
 *
 * There is no command palette and no overlay: search is a page with a field,
 * a live region and a list of results, which is what makes it work with a
 * keyboard, a screen reader and the back button alike.
 *
 * The initial markup states what is searchable and what to do without
 * JavaScript. The script replaces that advice once it is running.
 */

const site = await loadSite();
const hasContent = site.posts.length > 0 || site.pages.size > 0;

const meta = buildMetadata({
  title: '搜索',
  description: '搜索 nano-blog 的公开文章与页面。',
  pathname: '/search/',
  // A results page is not content and must never be indexed.
  noindex: true,
});
---

<BaseLayout meta={meta}>
  <div class="wrap" data-search-root data-has-content={String(hasContent)} data-status="initial">
    <div class="page-head">
      <h1>搜索</h1>
      <p class="page-head__description">
        在本站已发布的文章中检索。索引在构建时生成，搜索在你的浏览器中完成，查询不会发送到任何服务器。
      </p>
    </div>

    <form class="search-form" role="search" data-search-form>
      <label class="search-form__label" for="search-input">关键词</label>
      <div class="search-form__row">
        <input
          class="search-form__input"
          id="search-input"
          name="q"
          type="search"
          autocomplete="off"
          enterkeyhint="search"
          data-search-input
        />
        <button class="search-form__submit" type="submit">搜索</button>
      </div>
    </form>

    <p class="search-status" data-search-status role="status" aria-live="polite">
      输入关键词以搜索站内文章与页面。
    </p>

    <ol class="search-results" data-search-results></ol>

    <div class="search-fallback" data-search-fallback>
      {
        hasContent ? (
          <>
            <p>
              站内搜索需要 JavaScript。你可以改用浏览器自带的页面查找，或从
              <a href={postsIndexUrl}>文章索引</a>、<a href={archivePageUrl(1)}>归档</a>
              浏览全部文章。
            </p>
          </>
        ) : (
          <p>暂无可搜索的公开内容。</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  import { initSearch } from '../scripts/search.js';
  initSearch();
</script>

<style>
  .search-form {
    margin-block: var(--space-24);
    max-width: var(--measure-article);
  }

  .search-form__label {
    display: block;
    font-size: var(--font-size-meta-lg);
    font-weight: 600;
    margin-block-end: var(--space-4);
  }

  .search-form__row {
    display: flex;
    gap: var(--space-8);
  }

  .search-form__input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: var(--space-8) var(--space-12);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-2);
  }

  .search-form__submit {
    min-height: 44px;
    padding: var(--space-8) var(--space-16);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-2);
    cursor: pointer;
  }

  .search-form__submit:hover {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .search-status {
    font-size: var(--font-size-meta-lg);
    color: var(--color-muted);
    margin-block-end: var(--space-16);
  }

  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure-article);
  }

  .search-results :global(.search-result) {
    padding-block: var(--space-16);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .search-results :global(.search-result__title) {
    font-size: 1.0625rem;
    margin: 0;
  }

  .search-results :global(.search-result__link) {
    color: var(--color-text);
    text-decoration: none;
  }

  .search-results :global(.search-result__link:hover) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .search-results :global(.search-result__excerpt) {
    margin-block-start: var(--space-4);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .search-results :global(.search-result__excerpt mark) {
    background: var(--color-brand-soft);
    color: var(--color-text);
  }

  .search-results :global(.search-result__meta) {
    margin-block-start: var(--space-4);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  .search-fallback {
    margin-block-start: var(--space-16);
    color: var(--color-muted);
    max-width: var(--measure-article);
  }

  /*
   * The fallback is visible on purpose.
   *
   * It carries the no-JavaScript advice — "search needs JavaScript, here is the
   * article index instead" — so it must be on screen until the script is
   * running, and the script removes the element outright once it is. Hiding it
   * from the stylesheet would mean the one reader who needs it never sees it.
   */
</style>
