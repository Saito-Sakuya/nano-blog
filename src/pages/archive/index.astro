---
import EmptyState from '../../components/EmptyState.astro';
import IndexList from '../../components/IndexList.astro';
import Pagination from '../../components/Pagination.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { monthOf, yearOf } from '../../lib/content/build-context.js';
import { loadSite, type PostView } from '../../lib/content/collections.js';
import { archivePageUrl, pageSlice, paginate } from '../../lib/routing/urls.js';
import { buildMetadata } from '../../lib/seo/metadata.js';

/**
 * The archive, page one.
 *
 * Grouping happens over the slice of articles this page shows, not over the
 * whole archive, so a year or a month that straddles a page boundary is
 * repeated as a heading on both pages rather than being shown once with half
 * its articles on either side of the pagination.
 *
 * The month buckets come out of a `Map`, which preserves insertion order, so
 * feeding it the already newest-first article list is all the sorting the
 * archive needs.
 */

interface MonthGroup {
  readonly label: string;
  readonly posts: readonly PostView[];
}

interface YearGroup {
  readonly year: string;
  readonly count: number;
  readonly months: readonly MonthGroup[];
}

function groupByYearMonth(posts: readonly PostView[]): YearGroup[] {
  const years = new Map<string, Map<string, PostView[]>>();

  for (const post of posts) {
    const year = yearOf(post.data.publishedAt);
    const month = monthOf(post.data.publishedAt);

    let months = years.get(year);
    if (months === undefined) {
      months = new Map();
      years.set(year, months);
    }

    const bucket = months.get(month);
    if (bucket === undefined) {
      months.set(month, [post]);
    } else {
      bucket.push(post);
    }
  }

  return [...years.entries()].map(([year, months]) => {
    const groups: MonthGroup[] = [...months.entries()].map(([month, monthPosts]) => ({
      label: `${year}-${month}`,
      posts: monthPosts,
    }));

    return {
      year,
      count: groups.reduce((total, group) => total + group.posts.length, 0),
      months: groups,
    };
  });
}

const site = await loadSite();
const posts = pageSlice(site.posts, 1);
const pagination = paginate(site.posts.length, 1, archivePageUrl);
const groups = groupByYearMonth(posts);

const meta = buildMetadata({
  title: '归档',
  description: '按年份与月份排列的全部公开文章，每页 10 篇。',
  pathname: archivePageUrl(1),
});
---

<BaseLayout meta={meta}>
  <div class="wrap">
    <div class="page-head">
      <h1>归档</h1>
      <p class="page-head__description">按年份与月份排列的全部公开文章，每页 10 篇。</p>
    </div>

    {
      site.posts.length === 0 ? (
        <EmptyState message="尚无可归档的公开文章。" />
      ) : (
        <>
          {groups.map((group) => (
            <section class="archive-year">
              <h2 class="archive-year__title">
                {group.year}
                <span class="archive-year__count">{group.count} 篇</span>
              </h2>

              {group.months.map((month) => (
                <>
                  <h3 class="archive-month__title">{month.label}</h3>
                  <IndexList posts={month.posts} variant="archive" />
                </>
              ))}
            </section>
          ))}

          <Pagination pagination={pagination} label="归档分页" />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .archive-year + .archive-year {
    margin-block-start: var(--space-48);
  }

  .archive-year__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-8);
    font-size: 1.25rem;
    padding-block-end: var(--space-8);
    border-block-end: var(--border-width-strong) solid var(--color-brand);
  }

  .archive-year__count {
    font-size: var(--font-size-meta);
    font-weight: 400;
    color: var(--color-muted);
  }

  .archive-month__title {
    margin-block: var(--space-24) var(--space-4);
    font-size: var(--font-size-meta-lg);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
