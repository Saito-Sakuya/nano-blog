---
/**
 * Theme control — a bookmark-shaped trigger opening a three-way chooser.
 *
 * The container is `hidden` in the markup and revealed by the script. Without
 * JavaScript the site follows the system preference through CSS alone, and a
 * control that could not do anything is never shown.
 */
---

<div class="theme-toggle" data-theme-toggle hidden>
  {/*
    The `id` is not decoration: the menu below names itself with
    `aria-labelledby="theme-button"`, and a `role="menu"` whose label resolves
    to nothing is announced as an unnamed menu. The reference is to the trigger
    because that is what tells the reader which menu this is.
  */}
  <button
    class="bookmark bookmark--button"
    type="button"
    id="theme-button"
    data-theme-button
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <span data-theme-label>主题</span>
  </button>

  <ul class="theme-menu" id="theme-menu" role="menu" aria-labelledby="theme-button" data-theme-menu hidden>
    <li role="none">
      <button class="theme-menu__item" type="button" role="menuitemradio" aria-checked="false" data-theme-value="light">
        浅色
      </button>
    </li>
    <li role="none">
      <button class="theme-menu__item" type="button" role="menuitemradio" aria-checked="false" data-theme-value="dark">
        深色
      </button>
    </li>
    <li role="none">
      <button class="theme-menu__item" type="button" role="menuitemradio" aria-checked="false" data-theme-value="system">
        跟随系统
      </button>
    </li>
  </ul>
</div>

<script>
  import { initThemeToggle } from '../scripts/theme.js';
  initThemeToggle();
</script>

<style>
  @import '../styles/layers.css';

  @layer components {
    .theme-toggle {
      display: flex;
      align-items: stretch;
    }

    /*
     * A class rule outranks the user agent's `[hidden] { display: none }`, so the
     * `hidden` attribute alone would not keep the control off the page. Without
     * this, a reader with JavaScript disabled sees a theme button that cannot do
     * anything.
     */
    .theme-toggle[hidden] {
      display: none;
    }

    /*
     * Fixed rather than absolute: the navigation list scrolls horizontally on
     * narrow screens and would clip an absolutely positioned child. The position
     * is set from the trigger's bounding box by the script.
     *
     * The menu is drawn as a segmented row — the same control the narrow-screen
     * sheet uses — while keeping its menu semantics: arrow keys move, Escape
     * closes, and focus returns to the trigger.
     */
    .theme-menu {
      position: fixed;
      z-index: var(--z-overlay);
      display: flex;
      gap: 2px;
      padding: 3px;
      margin: 0;
      list-style: none;
      background: var(--color-bg);
      border: 1.5px solid var(--color-text);
      border-radius: var(--radius-8);
      box-shadow: var(--shadow-pixel);
    }

    .theme-menu[hidden] {
      display: none;
    }

    .theme-menu__item {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: var(--space-4) var(--space-16);
      background: transparent;
      border: 0;
      border-radius: var(--radius-2);
      font-size: var(--font-size-meta-lg);
      white-space: nowrap;
      cursor: pointer;
      transition: background-color var(--duration-120) var(--ease-standard);
    }

    .theme-menu__item:hover {
      background: var(--color-hover);
    }

    .theme-menu__item[aria-checked='true'] {
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 700;
    }
  }
</style>
