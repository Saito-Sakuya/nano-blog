{
  "name": "nano-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "nano-blog — a Markdown/MDX driven personal blog, statically generated with Astro.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "tsx scripts/build/dev.ts",
    "dev:fixtures": "tsx scripts/build/dev.ts --source fixtures",
    "dev:api": "tsx scripts/build/dev-api.ts",
    "build": "tsx scripts/build/build.ts",
    "build:fixtures": "tsx scripts/build/build.ts --source fixtures",
    "build:pages": "tsx scripts/build/build.ts --source r2 --site-env-from-env",
    "preview": "tsx scripts/build/preview.ts",
    "preview:fixtures": "tsx scripts/build/preview.ts --dir dist-fixtures",
    "check": "astro check",
    "check:types": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/verify/e2e.ts",
    "test:a11y": "tsx scripts/verify/a11y.ts",
    "test:links": "tsx scripts/verify/links.ts",
    "test:visual": "tsx scripts/verify/visual.ts",
    "test:performance": "tsx scripts/verify/performance.ts",
    "test:lighthouse": "tsx scripts/verify/lighthouse.ts",
    "test:nav": "tsx scripts/verify/nav-stability.ts",
    "search:index": "tsx scripts/build/search-index.ts",
    "verify": "tsx scripts/verify/all.ts",
    "content:pull": "tsx scripts/content/pull.ts",
    "content:new": "tsx scripts/content/new.ts",
    "content:validate": "tsx scripts/content/validate-cmd.ts",
    "content:seo": "tsx scripts/content/seo.ts",
    "content:publish": "tsx scripts/content/publish.ts",
    "content:rollback": "tsx scripts/content/rollback.ts",
    "content:cleanup": "tsx scripts/content/cleanup.ts",
    "comments:review": "tsx scripts/content/comments-review.ts",
    "media:add": "tsx scripts/media/add.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@aws-sdk/client-s3": "3.1131.0",
    "astro": "7.3.2",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "js-yaml": "5.4.2",
    "katex": "0.18.7",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "unist-util-visit": "5.1.0",
    "unist-util-visit-parents": "6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/js-yaml": "4.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.4",
    "@types/unist": "3.0.3",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "lighthouse": "13.4.1",
    "markdownlint-cli2": "0.23.2",
    "mdast-util-mdx-jsx": "3.2.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unified": "11.0.5",
    "vitest": "5.0.0"
  }
}
