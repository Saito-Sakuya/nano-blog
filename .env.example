# nano-blog — environment variables
#
# Copy to `.env` and fill in secret values locally. Secret values are empty in
# this file on purpose: the repository never contains real credentials.
# `.env` and every `.env.*` file except this one are git-ignored.

# ---------------------------------------------------------------------------
# Site (non-secret, used at build time)
# ---------------------------------------------------------------------------

# Canonical origin of the published site. Replace the example value. HTTPS,
# origin only (no credentials, path, query, fragment or trailing slash).
SITE_URL=

# Public origin serving the media bucket. The build binds this value into the
# emitted CSP. A missing or invalid HTTPS origin fails a Pages build; a valid
# but incorrect origin can only be detected by checking the deployed site.
PUBLIC_MEDIA_ORIGIN=

# IANA time zone used for every date decision at build time.
SITE_TIME_ZONE=Asia/Taipei

# Deployment environment. One of: local | preview | production.
# Cloudflare Pages must set this explicitly for each environment.
SITE_ENV=local

# ---------------------------------------------------------------------------
# R2 (non-secret identifiers; never exposed to the browser)
# ---------------------------------------------------------------------------

R2_ACCOUNT_ID=
R2_CONTENT_BUCKET=nano-blog-content
R2_MEDIA_BUCKET=nano-blog-media

# ---------------------------------------------------------------------------
# R2 credentials — three least-privilege groups
# ---------------------------------------------------------------------------

# 1. Pages build credentials: Object Read only on BOTH content and media
#    buckets. build:pages downloads and hashes the active release plus every
#    referenced media family before generating the site.
R2_BUILD_ACCESS_KEY_ID=
R2_BUILD_SECRET_ACCESS_KEY=

# 2. Author credentials: Object Read & Write on both buckets. Cloudflare's R2
#    S3 token UI does not expose a put-without-delete permission; treat this key
#    as deletion-capable even though author commands never call delete.
R2_AUTHOR_ACCESS_KEY_ID=
R2_AUTHOR_SECRET_ACCESS_KEY=

# 3. Cleanup credentials: a separate Object Read & Write key on both buckets.
#    It is read only inside `content:cleanup --apply`, providing operational
#    separation and independent rotation, not a stronger Cloudflare IAM scope.
R2_CLEANUP_ACCESS_KEY_ID=
R2_CLEANUP_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Workers AI — manual SEO suggestions only, never at build time
# ---------------------------------------------------------------------------

CF_WORKERS_AI_ACCOUNT_ID=
# Token scope: Workers AI Run only.
CF_WORKERS_AI_API_TOKEN=

# ---------------------------------------------------------------------------
# Comments and view counts (Cloudflare Pages Functions + D1)
# ---------------------------------------------------------------------------

# D1 database id, from `wrangler d1 create` or the Cloudflare dashboard.
CF_D1_DATABASE_ID=

# Token scoped to D1 edit on that database. Read only by `comments:review`.
CF_D1_API_TOKEN=

# The secret the Pages Functions layer uses to hash a commenter's address for
# rate limiting, so the address itself is never stored. Must be at least 32
# characters. Generate with: openssl rand -hex 32
#
# This is set in the Cloudflare Pages environment, not read from this file by
# any local command — the comment endpoints run at the edge, not here.
COMMENTS_IP_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Pages Deploy Hook — treat exactly like a password
# ---------------------------------------------------------------------------

CF_PAGES_DEPLOY_HOOK_URL=
